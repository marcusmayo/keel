# Structural exclusion: residue + secrets never enter build context.
.git
node_modules
webchat/node_modules
webchat/service.env
state/
knowledge/
logs/
support/
exports/
*.xlsx
*.bak*
*.pre-*
infra/
!infra/docker/requirements.txt

# The deploy-time name overlay must NOT enter the image. It used to arrive via COPY system/,
# which made <profile>:<sha> different bytes on every host: same tag, different agent name.
# The name now arrives at container start from the env file bootstrap writes.
system/agent.local.yaml
